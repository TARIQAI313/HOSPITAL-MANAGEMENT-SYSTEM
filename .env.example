# ==========================================
# AURACARE HOSPITAL MANAGEMENT CONFIGURATION
# ==========================================
# Configure your Supabase project credentials.
# In production, pass these via:
# flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...

# Supabase Project URL (e.g. https://xyzcompany.supabase.co or http://localhost:54321 for local dev)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Never use service-role key in Flutter client!)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_here

# Application Environment (development | staging | production)
APP_ENV=development

# Feature Flags
ENABLE_MOCK_FALLBACK=true
ENABLE_OFFLINE_QUEUE=true
